<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Almadina Plaza | Kacha Khuh</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f4f6f9;
    color:#172033;
}

/* NAVBAR */
.navbar{
    background:#101827;
    color:white;
    padding:16px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:1000;
}

.logo{
    font-size:23px;
    font-weight:bold;
}

.logo span{
    color:#f5b942;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

.menu{
    display:none;
    font-size:27px;
    cursor:pointer;
}

/* HERO */
.hero{
    min-height:570px;
    padding:80px 6%;
    display:flex;
    align-items:center;
    background:
        linear-gradient(rgba(7,15,30,.83),rgba(7,15,30,.9)),
        radial-gradient(circle at 80% 30%,#385477,#071020 65%);
    color:white;
}

.hero-content{
    max-width:760px;
}

.badge{
    display:inline-block;
    border:1px solid #f5b942;
    color:#f5b942;
    padding:9px 16px;
    border-radius:30px;
    margin-bottom:20px;
    font-weight:bold;
}

.hero h1{
    font-size:clamp(45px,8vw,80px);
    line-height:1;
    margin-bottom:20px;
}

.hero h1 span{
    color:#f5b942;
}

.hero p{
    color:#d8dfeb;
    font-size:19px;
    line-height:1.7;
    margin-bottom:28px;
}

.btn{
    display:inline-block;
    border:0;
    padding:14px 22px;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-gold{
    background:#f5b942;
    color:#111827;
}

.btn-white{
    background:white;
    color:#111827;
    margin-left:8px;
}

/* STATS */
.stats{
    margin:-45px 6% 50px;
    background:white;
    position:relative;
    border-radius:16px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    box-shadow:0 12px 40px rgba(0,0,0,.1);
    overflow:hidden;
}

.stat{
    padding:28px;
    text-align:center;
    border-right:1px solid #e5e8ed;
}

.stat:last-child{
    border-right:0;
}

.stat h2{
    font-size:30px;
}

.stat p{
    color:#747d8d;
    margin-top:7px;
}

/* SECTIONS */
section{
    padding:70px 6%;
}

.title{
    text-align:center;
    margin-bottom:40px;
}

.title small{
    color:#d99d21;
    text-transform:uppercase;
    letter-spacing:2px;
    font-weight:bold;
}

.title h2{
    font-size:38px;
    margin:9px 0;
}

.title p{
    max-width:650px;
    margin:auto;
    color:#6d7687;
    line-height:1.7;
}

/* ABOUT */
.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
}

.box{
    background:white;
    padding:35px;
    border-radius:15px;
    box-shadow:0 7px 30px rgba(0,0,0,.06);
}

.box h3{
    font-size:27px;
    margin-bottom:15px;
}

.box p{
    color:#687386;
    line-height:1.8;
    margin-bottom:15px;
}

.features{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-top:20px;
}

.feature{
    padding:15px;
    background:#f4f6f9;
    border-radius:9px;
    font-weight:bold;
}

/* SHOP SECTION */
.shop-section{
    background:#eef1f5;
}

.controls{
    max-width:900px;
    margin:0 auto 30px;
    display:flex;
    gap:10px;
}

.search{
    flex:1;
    padding:14px;
    border:1px solid #d5dae3;
    border-radius:8px;
    font-size:15px;
    outline:none;
}

select{
    padding:14px;
    border:1px solid #d5dae3;
    border-radius:8px;
    background:white;
}

.shop-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.shop{
    background:white;
    padding:20px;
    border-radius:14px;
    box-shadow:0 6px 25px rgba(0,0,0,.06);
    transition:.3s;
}

.shop:hover{
    transform:translateY(-4px);
}

.shop-no{
    width:45px;
    height:45px;
    background:#101827;
    color:#f5b942;
    border-radius:10px;
    display:grid;
    place-items:center;
    font-weight:bold;
    margin-bottom:14px;
}

.shop h3{
    margin-bottom:6px;
}

.shop p{
    color:#788294;
    font-size:14px;
    margin-bottom:12px;
}

.status{
    display:inline-block;
    padding:6px 10px;
    border-radius:20px;
    font-size:12px;
    font-weight:bold;
    margin-bottom:14px;
}

.available{
    background:#e5f8ed;
    color:#168246;
}

.rented{
    background:#fde7e7;
    color:#c33333;
}

.whatsapp-btn{
    width:100%;
    padding:11px;
    border:0;
    border-radius:7px;
    background:#25d366;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

.disabled{
    width:100%;
    padding:11px;
    border:0;
    border-radius:7px;
    background:#e7eaf0;
    color:#8a92a0;
}

/* RENT */
.rent{
    background:#101827;
    color:white;
    text-align:center;
}

.rent h2{
    font-size:40px;
    margin-bottom:12px;
}

.rent p{
    max-width:650px;
    margin:auto auto 25px;
    color:#cbd2de;
    line-height:1.7;
}

/* CONTACT */
.contact-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.contact{
    background:white;
    padding:30px;
    border-radius:14px;
    text-align:center;
    box-shadow:0 7px 25px rgba(0,0,0,.06);
}

.contact-icon{
    font-size:34px;
    margin-bottom:12px;
}

.contact h3{
    margin-bottom:7px;
}

.contact p{
    color:#70798a;
}

.contact a{
    color:#172033;
    font-weight:bold;
    text-decoration:none;
}

/* ADMIN */
.admin-section{
    display:none;
    background:#101827;
    color:white;
}

.admin-section.active{
    display:block;
}

.admin-title{
    text-align:center;
    margin-bottom:30px;
}

.admin-title h2{
    font-size:34px;
}

.admin-panel{
    max-width:1000px;
    margin:auto;
    background:white;
    color:#172033;
    padding:25px;
    border-radius:15px;
}

.admin-row{
    display:grid;
    grid-template-columns:70px 1fr 1fr 150px;
    gap:10px;
    align-items:center;
    padding:12px 0;
    border-bottom:1px solid #e8ebf0;
}

.admin-row input,
.admin-row select{
    width:100%;
    padding:10px;
}

.save-btn{
    background:#101827;
    color:white;
    border:0;
    padding:10px 15px;
    border-radius:7px;
    cursor:pointer;
    font-weight:bold;
}

.admin-info{
    background:#fff4d8;
    color:#77580d;
    padding:13px;
    border-radius:8px;
    margin-bottom:20px;
    line-height:1.5;
}

/* FOOTER */
footer{
    background:#080e1a;
    color:white;
    text-align:center;
    padding:28px;
}

footer p{
    color:#9ba5b5;
    margin-top:7px;
}

/* FLOATING WHATSAPP */
.float-wa{
    position:fixed;
    right:18px;
    bottom:18px;
    width:58px;
    height:58px;
    border-radius:50%;
    background:#25d366;
    color:white;
    display:grid;
    place-items:center;
    font-size:27px;
    text-decoration:none;
    box-shadow:0 7px 25px rgba(0,0,0,.25);
    z-index:999;
}

/* MOBILE */
@media(max-width:1000px){
    .shop-grid{
        grid-template-columns:repeat(3,1fr);
    }
}

@media(max-width:750px){

    .nav-links{
        display:none;
        position:absolute;
        top:62px;
        left:0;
        right:0;
        background:#101827;
        padding:20px 6%;
        flex-direction:column;
    }

    .nav-links.show{
        display:flex;
    }

    .menu{
        display:block;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .stat{
        border-right:0;
        border-bottom:1px solid #e5e8ed;
    }

    .about{
        grid-template-columns:1fr;
    }

    .shop-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .contact-grid{
        grid-template-columns:1fr;
    }

    .admin-row{
        grid-template-columns:1fr;
    }
}

@media(max-width:500px){

    section{
        padding:55px 5%;
    }

    .hero{
        padding:70px 5%;
    }

    .hero h1{
        font-size:48px;
    }

    .hero p{
        font-size:16px;
    }

    .btn{
        width:100%;
        text-align:center;
        margin:5px 0;
    }

    .btn-white{
        margin-left:0;
    }

