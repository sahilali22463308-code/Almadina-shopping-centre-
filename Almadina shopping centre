<script>

/* ===============================
   DEFAULT 35 SHOPS
================================ */

const defaultShops = [];

for(let i = 1; i <= 35; i++){

    defaultShops.push({

        number: i,

        name: "Shop " + String(i).padStart(2,"0"),

        category: "Commercial Shop",

        status: "available"

    });

}


/* ===============================
   LOAD SAVED SHOPS
================================ */

let shops =
    JSON.parse(localStorage.getItem("almadinaShops"))
    || defaultShops;


/* ===============================
   DISPLAY SHOPS
================================ */

function displayShops(list = shops){

    const grid =
        document.getElementById("shopGrid");

    grid.innerHTML = "";


    if(list.length === 0){

        grid.innerHTML = `
            <div style="
                grid-column:1/-1;
                background:white;
                padding:40px;
                border-radius:12px;
                text-align:center;
            ">
                <h3>No shop found</h3>
            </div>
        `;

        return;
    }


    list.forEach(shop => {

        const card =
            document.createElement("div");

        card.className = "shop";


        const isAvailable =
            shop.status === "available";


        card.innerHTML = `

            <div class="shop-no">
                ${String(shop.number).padStart(2,"0")}
            </div>

            <h3>${escapeHTML(shop.name)}</h3>

            <p>📌 ${escapeHTML(shop.category)}</p>

            <span class="status ${
                isAvailable
                ? "available"
                : "rented"
            }">

                ${
                    isAvailable
                    ? "● Available"
                    : "● Rented"
                }

            </span>

            ${
                isAvailable

                ?

                `
                <button
                    class="whatsapp-btn"
                    onclick="rentShop(${shop.number})"
                >
                    💬 Rent This Shop
                </button>
                `

                :

                `
                <button
                    class="disabled"
                    disabled
                >
                    Currently Rented
                </button>
                `
            }

        `;


        grid.appendChild(card);

    });

}


/* ===============================
   RENT SHOP WHATSAPP
================================ */

function rentShop(number){

    const message =
        `Assalam o Alaikum, I am interested in renting Shop #${number} at Almadina Plaza, Kacha Khuh. Please provide me with the rent, terms and other details.`;

    const url =
        "https://wa.me/923006899901?text="
        + encodeURIComponent(message);

    window.open(url,"_blank");

}


/* ===============================
   SEARCH / FILTER
================================ */

function filterShops(){

    const search =
        document
        .getElementById("search")
        .value
        .toLowerCase();

    const filter =
        document
        .getElementById("filter")
        .value;


    const result =
        shops.filter(shop => {

            const searchMatch =
                shop.name.toLowerCase().includes(search)
                ||
                shop.category.toLowerCase().includes(search)
                ||
                String(shop.number).includes(search);


            const statusMatch =
                filter === "all"
                ||
                shop.status === filter;


            return searchMatch && statusMatch;

        });


    displayShops(result);

}


/* ===============================
   ADMIN PANEL
================================ */

function displayAdmin(){

    const admin =
        document.getElementById("adminList");

    admin.innerHTML = "";


    shops.forEach((shop,index) => {

        const row =
            document.createElement("div");

        row.className = "admin-row";


        row.innerHTML = `

            <strong>
                #${shop.number}
            </strong>

            <input
                type="text"
                id="name-${index}"
                value="${escapeAttribute(shop.name)}"
                placeholder="Shop name"
            >

            <input
                type="text"
                id="category-${index}"
                value="${escapeAttribute(shop.category)}"
                placeholder="Category"
            >

            <select id="status-${index}">

                <option
                    value="available"
                    ${
                        shop.status === "available"
                        ? "selected"
                        : ""
                    }
                >
                    Available
                </option>

                <option
                    value="rented"
                    ${
                        shop.status === "rented"
                        ? "selected"
                        : ""
                    }
                >
                    Rented
                </option>

            </select>

            <button
                class="save-btn"
                onclick="saveShop(${index})"
            >
       