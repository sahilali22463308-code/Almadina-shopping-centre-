        grid-template-columns:1fr;
    }

    .features{
        grid-template-columns:1fr;
    }

    .controls{
        flex-direction:column;
    }

    .title h2{
        font-size:32px;
    }

    .box{
        padding:25px;
    }
}
</style>
</head>

